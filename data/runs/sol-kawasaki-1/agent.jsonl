{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"cat > webapp/go/dns.go <<'EOF'\npackage main\n\nimport (\n \\\"fmt\\\"\n \\\"net\\\"\n \\\"os\\\"\n \\\"strings\\\"\n \\\"sync\\\"\n \\\"github.com/jmoiron/sqlx\\\"\n \\\"golang.org/x/net/dns/dnsmessage\\\"\n)\n\nvar dnsDB *sqlx.DB\nvar dnsRecords struct { sync.RWMutex; names map[string][]dnsmessage.Resource }\n\nfunc reloadDNS() error {\n if dnsDB==nil {return nil}\n var rows []struct {Name string \"'`db:\"name\"`; Type string `db:\"type\"`; Content string `db:\"content\"`; TTL uint32 `db:\"ttl\"`}\n if err:=dnsDB.Select(&rows,`SELECT name,type,content,ttl FROM records WHERE disabled=0`);err!=nil {return err}\n records:=make(map[string][]dnsmessage.Resource,len(rows))\n for _,row:=range rows {\n  key:=strings.ToLower(strings.TrimSuffix(row.Name,\".\"))+\".\"\n  name,err:=dnsmessage.NewName(key);if err!=nil {return err}\n  r:=dnsmessage.Resource{Header:dnsmessage.ResourceHeader{Name:name,Class:dnsmessage.ClassINET,TTL:60}}\n  switch row.Type {\n  case \"A\":\n   ip:=net.ParseIP(row.Content).To4();if ip==nil {return fmt.Errorf(\"invalid A record %s\",row.Name)}\n   r.Header.Type=dnsmessage.TypeA;r.Body=&dnsmessage.AResource{A:[4]byte{ip[0],ip[1],ip[2],ip[3]}}\n  case \"NS\":\n   ns,err:=dnsmessage.NewName(strings.TrimSuffix(row.Content,\".\")+\".\");if err!=nil{return err}\n   r.Header.Type=dnsmessage.TypeNS;r.Body=&dnsmessage.NSResource{NS:ns}\n  case \"SOA\":\n   fields:=strings.Fields(row.Content);if len(fields)!=7 {return fmt.Errorf(\"invalid SOA\")}\n   ns,_:=dnsmessage.NewName(strings.TrimSuffix(fields[0],\".\")+\".\")\n   mb,_:=dnsmessage.NewName(strings.TrimSuffix(fields[1],\".\")+\".\")\n   var serial,refresh,retry,expire,min uint32\n   if _,err:=fmt.Sscanf(strings.Join(fields[2:],\" \"),\"%d %d %d %d %d\",&serial,&refresh,&retry,&expire,&min);err!=nil{return err}\n   r.Header.Type=dnsmessage.TypeSOA;r.Body=&dnsmessage.SOAResource{NS:ns,MBox:mb,Serial:serial,Refresh:refresh,Retry:retry,Expire:expire,MinTTL:min}\n  default:continue\n  }\n  records[key]=append(records[key],r)\n }\n dnsRecords.Lock();dnsRecords.names=records;dnsRecords.Unlock()\n return nil\n}\n\nfunc startDNS() error {\n addr:=os.Getenv(\"ISUCON_DNS_LISTEN\");if addr==\"\" {return nil}\n var err error\n dnsDB,err=sqlx.Open(\"mysql\",\"isudns:isudns@tcp(127.0.0.1:3306)/isudns\");if err!=nil{return err}\n if err=reloadDNS();err!=nil{return err}\n udpAddr,err:=net.ResolveUDPAddr(\"udp\",addr);if err!=nil{return err}\n conn,err:=net.ListenUDP(\"udp\",udpAddr);if err!=nil{return err}\n conn.SetReadBuffer(4<<20);conn.SetWriteBuffer(4<<20)\n for i:=0;i<2;i++ {go func(){\n  buf:=make([]byte,4096)\n  for {\n   n,remote,err:=conn.ReadFromUDP(buf);if err!=nil {continue}\n   var q dnsmessage.Message\n   if err=q.Unpack(buf[:n]);err!=nil||q.Header.Response||len(q.Questions)!=1 {continue}\n   question:=q.Questions[0]\n   key:=strings.ToLower(question.Name.String())\n   reply:=dnsmessage.Message{Header:dnsmessage.Header{ID:q.Header.ID,Response:true,Authoritative:true,RecursionDesired:q.Header.RecursionDesired},Questions:q.Questions}\n   if key!=\"u.isucon.dev.\"&&!strings.HasSuffix(key,\".u.isucon.dev.\") {\n    reply.Header.Authoritative=false;reply.Header.RCode=dnsmessage.RCodeRefused\n   } else {\n    dnsRecords.RLock();resources,exists:=dnsRecords.names[key]\n    if !exists {reply.Header.RCode=dnsmessage.RCodeNameError}\n    for _,r:=range resources {if question.Type==r.Header.Type||question.Type==dnsmessage.TypeALL {reply.Answers=append(reply.Answers,r)}}\n    if len(reply.Answers)==0 {for _,r:=range dnsRecords.names[\"u.isucon.dev.\"] {if r.Header.Type==dnsmessage.TypeSOA {reply.Authorities=append(reply.Authorities,r)}}}\n    dnsRecords.RUnlock()\n   }\n   packet,err:=reply.Pack();if err!=nil {continue}\n   conn.WriteToUDP(packet,remote)\n  }\n }()}\n return nil\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('webapp/go/main.go');s=p.read_text().repl