{"type":"item.started","item":{"id":"item_114","type":"command_execution","command":"/bin/bash -lc \"cat > scripts/verify_persistence.py <<'EOF'\nimport base64\nimport hashlib\nimport http.client\nimport json\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport time\n\nSTATE = Path('backups/integration-state.json')\nHOSTS = ('10.99.0.11', '10.99.0.13')\n\ndef request(host, method, path, data=None, cookie=None, etag=None):\n    connection = http.client.HTTPConnection(host, 8080, timeout=5)\n    headers = {'Host': 'pipe.u.isucon.dev'}\n    if cookie:\n        headers['Cookie'] = cookie\n    if etag:\n        headers['If-None-Match'] = etag\n    body = None\n    if data is not None:\n        body = json.dumps(data)\n        headers['Content-Type'] = 'application/json'\n    connection.request(method, path, body, headers)\n    response = connection.getresponse()\n    result = (response.status, dict(response.getheaders()), response.read())\n    connection.close()\n    return result\n\ndef check(state):\n    image = base64.b64decode(state['image'])\n    digest = hashlib.sha256(image).hexdigest()\n    path = '/api/user/' + state['username']\n    for host in HOSTS:\n        status, _, body = request(host, 'GET', path, cookie=state['cookie'])\n        assert status == 200, (host, status)\n        user = json.loads(body)\n        assert user['id'] == state['user_id'] and user['icon_hash'] == digest, (host, user)\n        status, headers, body = request(host, 'GET', path + '/icon')\n        assert status == 200 and body == image, (host, status)\n        assert headers.get('Etag', headers.get('ETag')) == '\\\"' + digest + '\\\"'\n        status, _, body = request(host, 'GET', path + '/icon', etag='\\\"' + digest + '\\\"')\n        assert status == 304 and not body, (host, status)\n    answer = subprocess.check_output(['ssh', 's1', 'dig', '+short', '@127.0.0.1', state['username'] + '.u.isucon.dev'], text=True).strip()\n    assert answer == '10.99.0.11', answer\n    return digest\n\nif '--create' in sys.argv:\n    username = 'verify' + str(int(time.time()))\n    status, _, body = request(HOSTS[0], 'POST', '/api/register', {'name': username, 'display_name': 'Persistence check', 'description': 'Cross-server persistence verification', 'password': 'verification-only', 'theme': {'dark_mode': True}})\n    assert status == 201, (status, body)\n    user_id = json.loads(body)['id']\n    status, headers, _ = request(HOSTS[0], 'POST', '/api/login', {'username': username, 'password': 'verification-only'})\n    assert status == 200\n    cookie = headers['Set-Cookie'].split(';', 1)[0]\n    state = {'username': username, 'user_id': user_id, 'cookie': cookie}\n    original = Path('webapp/img/NoImage.jpg').read_bytes()\n    for index, host in enumerate(HOSTS):\n        image = original + ('verification-' + str(index)).encode()\n        state['image'] = base64.b64encode(image).decode()\n        status, _, body = request(host, 'POST', '/api/icon', {'image': state['image']}, cookie=cookie)\n        assert status == 201, (status, body)\n        start = time.monotonic()\n        while True:\n            try:\n                digest = check(state)\n                break\n            except AssertionError:\n                if time.monotonic() - start >= 2:\n                    raise\n                time.sleep(0.1)\n        print(json.dumps({'icon_update_server': host, 'visible_on_both_servers_in_seconds': round(time.monotonic() - start, 3)}))\n    STATE.parent.mkdir(exist_ok=True)\n    STATE.write_text(json.dumps(state))\nelse:\n    state = json.loads(STATE.read_text())\n    digest = check(state)\n    Path('results/persistence-check.json').write_text(json.dumps({'pass': True, 'user_id': state['user_id'], 'image_sha256': digest, 'checked_servers': list(HOSTS), 'dns_address': '10.99.0.11'}, indent=2) + '\\\\n')\n    print('Persistent user, image, session and DNS verified on both application servers.')\nEOF\npython3 scripts/verify_persistence.py --create\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
