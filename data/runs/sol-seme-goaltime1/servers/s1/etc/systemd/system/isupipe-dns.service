[Unit]
Description=ISUPipe in-memory authoritative DNS
After=network.target mysql.service
Requires=mysql.service

[Service]
User=isucon
WorkingDirectory=/home/isucon/webapp/go
ExecStart=/home/isucon/webapp/go/isupipe-dns
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
