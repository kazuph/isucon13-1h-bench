[Unit]
Description=ISUPipe DNS and bcrypt worker
After=network-online.target
Wants=network-online.target
[Service]
EnvironmentFile=-/home/isucon/worker.env
ExecStart=/home/isucon/webapp/worker
User=isucon
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=1
[Install]
WantedBy=multi-user.target
