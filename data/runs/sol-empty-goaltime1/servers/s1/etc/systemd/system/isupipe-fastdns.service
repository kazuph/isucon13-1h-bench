[Unit]
Description=ISUPipe authoritative DNS
After=network.target
Conflicts=pdns.service isupipe-fastdns-prototype.service
StartLimitIntervalSec=0
[Service]
User=isucon
Group=isucon
WorkingDirectory=/home/isucon/webapp/go
EnvironmentFile=/home/isucon/env.sh
Environment=FASTDNS_ADDR=0.0.0.0:53
Environment=FASTDNS_API_ADDR=0.0.0.0:8081
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/home/isucon/webapp/go/fastdns
Restart=on-failure
RestartSec=1
[Install]
WantedBy=multi-user.target
