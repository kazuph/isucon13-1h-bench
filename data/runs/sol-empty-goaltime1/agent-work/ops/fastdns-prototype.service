[Unit]
Description=ISUPipe DNS prototype
After=network.target
[Service]
User=isucon
Group=isucon
WorkingDirectory=/home/isucon/webapp/go
EnvironmentFile=/home/isucon/env.sh
Environment=FASTDNS_ADDR=127.0.0.1:5354
Environment=FASTDNS_API_ADDR=127.0.0.1:8082
ExecStart=/home/isucon/webapp/go/fastdns
Restart=on-failure
RestartSec=2
[Install]
WantedBy=multi-user.target
