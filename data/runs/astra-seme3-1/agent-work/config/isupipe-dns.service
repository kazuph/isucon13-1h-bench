[Unit]
Wants=isucon-announce.service
After=isucon-announce.service
Description=ISUPipe DNS server
After=network.target
[Service]
User=isucon
Environment=DNS_ONLY=1
ExecStart=/home/isucon/webapp/current/isupipe
Restart=always
RestartSec=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
[Install]
WantedBy=multi-user.target
