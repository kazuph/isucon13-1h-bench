[Unit]
Description=isupipe in-memory
After=network.target mysql.service
Wants=mysql.service

[Service]
WorkingDirectory=/home/isucon/app
EnvironmentFile=/home/isucon/env.sh
EnvironmentFile=-/home/isucon/app/conf/extra.env
User=isucon
Group=isucon
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=1000000
ExecStart=/home/isucon/app/isupipe
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
