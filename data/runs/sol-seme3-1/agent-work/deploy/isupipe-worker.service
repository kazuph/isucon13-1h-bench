[Unit]
Description=ISUPipe DNS and bcrypt worker
After=network.target
[Service]
User=isucon
WorkingDirectory=/home/isucon/webapp/go
Environment=DNS=0
ExecStartPre=+/home/isucon/webapp/go/announce
ExecStart=/home/isucon/webapp/go/worker
Restart=always
RestartSec=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
[Install]
WantedBy=multi-user.target
