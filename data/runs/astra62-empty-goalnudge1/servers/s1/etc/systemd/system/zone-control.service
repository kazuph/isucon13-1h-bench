[Unit]
Description=ISUPipe DNS record updates
After=pdns.service network-online.target
Requires=pdns.service
[Service]
User=isucon
SupplementaryGroups=pdns
RuntimeDirectory=isupipe-edge
RuntimeDirectoryMode=0755
WorkingDirectory=/home/isucon/webapp/pdns
EnvironmentFile=/home/isucon/env.sh
EnvironmentFile=/home/isucon/.zone-control.env
ExecStart=/home/isucon/webapp/pdns/zone-control
Restart=on-failure
RestartSec=1
[Install]
WantedBy=multi-user.target
