[Unit]
Description=ISUPipe authoritative in-memory DNS
After=network-online.target
[Service]
User=isucon
WorkingDirectory=/home/isucon/webapp/app
ExecStart=/home/isucon/webapp/app/isupipe dns
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=1
LimitNOFILE=65536
Environment=GOMAXPROCS=2
[Install]
WantedBy=multi-user.target
