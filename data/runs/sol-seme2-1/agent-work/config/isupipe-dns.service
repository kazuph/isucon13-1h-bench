[Unit]
Description=ISUPipe authoritative DNS
After=network-online.target
Wants=network-online.target
[Service]
User=isucon
Group=isucon
WorkingDirectory=/home/isucon/webapp/go
EnvironmentFile=/home/isucon/dns.env
ExecStart=/home/isucon/webapp/go/isupipe-dns dns
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
