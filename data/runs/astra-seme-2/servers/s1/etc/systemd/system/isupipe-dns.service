[Unit]
Description=ISUPipe authoritative DNS frontend
After=network.target
[Service]
User=isucon
WorkingDirectory=/home/isucon/webapp/go
Environment=DNS_FRONT=1
ExecStart=/home/isucon/webapp/go/isupipe-fast
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2
LimitNOFILE=100000
[Install]
WantedBy=multi-user.target
