[Unit]
Description=ISUPipe authoritative DNS
Wants=network-online.target pdns.service mysql.service
After=network-online.target pdns.service mysql.service

[Service]
User=isucon
Group=isucon
EnvironmentFile=/etc/isupipe-dns-edge.env
ExecStart=/home/isucon/webapp/go/dnsedge
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
